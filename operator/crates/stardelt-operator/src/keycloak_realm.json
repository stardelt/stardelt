{
  "realm": "stardelt",
  "displayName": "stardelt",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "groups": [
    {
      "name": "stardelt-admins",
      "path": "/stardelt-admins",
      "realmRoles": ["default-roles-stardelt"],
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups",
          "manage-users"
        ]
      }
    },
    {
      "name": "stardelt-users"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@__BASE_DOMAIN__",
      "emailVerified": true,
      "firstName": "stardelt",
      "lastName": "Admin",
      "groups": [
        "/stardelt-admins"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${STARDELT_REALM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-trino-group-sync",
      "enabled": true,
      "serviceAccountClientId": "trino-group-sync",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "service-account-pipeline-runner",
      "enabled": true,
      "serviceAccountClientId": "pipeline-runner"
    }
  ],
  "clients": [
    {
      "clientId": "nova",
